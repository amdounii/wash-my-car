# Copier ce fichier en .env (ignoré par git) ou définir ces variables dans l'IDE / le terminal.

# --- Base de données ---
DB_URL=jdbc:mysql://localhost:3306/washmycar?useUnicode=true&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=

# --- JWT : chaîne aléatoire d'au moins 32 caractères ---
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# --- URL publique de l'API (lien de validation par email) ---
APP_PUBLIC_URL=http://localhost:8081

# --- Origines autorisées (CORS) ---
CORS_ORIGINS=http://localhost:5173

# --- SMTP (laisser MAIL_HOST vide pour écrire les emails dans les logs) ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@washmycar.tn

# --- Admin créé au démarrage (optionnel si data.sql est importé) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
